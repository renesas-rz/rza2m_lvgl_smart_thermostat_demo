# Post-build memory report. Usage: cmake -DSIZE_TOOL=<arm-none-eabi-size> -DELF=<elf> -P memory_report.cmake
# Sums the allocated sections (arm-none-eabi-size -A) by the memory they are linked into.
execute_process(COMMAND "${SIZE_TOOL}" -A "${ELF}" OUTPUT_VARIABLE out RESULT_VARIABLE rc)
if(NOT rc EQUAL 0)
    message(FATAL_ERROR "size failed")
endif()
string(REPLACE "\n" ";" lines "${out}")
set(qspi 0) 
set(hyper 0)
set(iram 0)
set(uram 0)
foreach(l IN LISTS lines)
    # "<name> <size> <addr>"
    if(l MATCHES "^([^ ]+) +([0-9]+) +([0-9]+)")
        set(size ${CMAKE_MATCH_2})
        set(addr ${CMAKE_MATCH_3})
        if(addr EQUAL 0)
            continue()
        endif()
        math(EXPR top "${addr} >> 28" OUTPUT_FORMAT DECIMAL)
        math(EXPR top2 "${addr} >> 24" OUTPUT_FORMAT DECIMAL)
        if(top EQUAL 2)
            math(EXPR qspi "${qspi} + ${size}")
        elseif(top EQUAL 4)
            math(EXPR hyper "${hyper} + ${size}")
        elseif(top2 EQUAL 128 OR top2 EQUAL 129)      # 0x80xxxxxx internal RAM (cached)
            math(EXPR iram "${iram} + ${size}")
        elseif(top2 EQUAL 130 OR top2 EQUAL 131)      # 0x82xxxxxx internal RAM (uncached)
            math(EXPR uram "${uram} + ${size}")
        endif()
    endif()
endforeach()
message(STATUS "Memory use (bytes, linked sections by address range):")
message(STATUS "  QSPI flash   0x2xxxxxxx : ${qspi}")
message(STATUS "  HyperRAM     0x4xxxxxxx : ${hyper}")
message(STATUS "  Internal RAM 0x80xxxxxx : ${iram}   uncached 0x82xxxxxx : ${uram}")
