    ],
    "inputs": [
        {
            "id": "preset",
            "type": "pickString",
            "description": "Build whose ELF provides the symbols",
            "options": [
                "HardwareDebug",
                "HardwareRelease",
                "QSPIFlashDebug",
                "QSPIFlashRelease",
                "HyperRAMDebug",
                "HyperRAMRelease",
                "HyperRAMClut8Debug",
                "HyperRAMClut8Release"
            ],
            "default": "HardwareDebug"
        }
    ]
