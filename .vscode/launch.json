        {
            "name": "Debug HyperRAMClut8Debug (J-Link)",
            "request": "launch",
            "type": "cortex-debug",
            "servertype": "jlink",
            "device": "R7S921053VCBG",
            "interface": "swd",
            "serverArgs": [
                "-speed",
                "4000"
            ],
            "cwd": "${workspaceFolder}",
            "showDevDebugOutput": "none",
            "executable": "${workspaceFolder}/build/HyperRAMClut8Debug/rza2m_thermostat_demo.elf",
            "preLaunchTask": "Flash HyperRAMClut8Debug (J-Link)",
            "runToEntryPoint": "main",
