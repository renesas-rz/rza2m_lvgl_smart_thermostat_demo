            ]
        },
        {
            "name": "Attach (J-Link, no download)",
            "request": "attach",
            "type": "cortex-debug",
            "servertype": "jlink",
            "device": "R7S921053VCBG",
            "interface": "swd",
            "serverArgs": [
                "-speed",
                "4000"
            ],
            "cwd": "${workspaceFolder}",
            "showDevDebugOutput": "none",
            "executable": "${workspaceFolder}/build/${input:debugPreset}/rza2m_thermostat_demo.elf",
            "preAttachCommands": [
                "set arm fallback-mode arm"
            ]
        }
    ],
    "inputs": [
        {
            "id": "debugPreset",
            "type": "pickString",
            "description": "Select Debug build whose ELF provides the symbols",
            "options": [
                "HardwareDebug",
                "QSPIFlashDebug",
                "HyperRAMDebug",
                "HyperRAMClut8Debug"
            ],
            "default": "HardwareDebug"
        }
    ]
}