{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug HardwareDebug (J-Link)",
            "request": "launch",
            "type": "cortex-debug",
            "servertype": "jlink",
            "device": "R7S921053VCBG",
            "interface": "swd",
            "serverArgs": [
                "-speed",
                "4000"
            ],
            "cwd": "${workspaceFolder}",
            "showDevDebugOutput": "none",
            "executable": "${workspaceFolder}/build/HardwareDebug/rza2m_thermostat_demo.elf",
            "preLaunchTask": "Flash HardwareDebug (J-Link)",
            "runToEntryPoint": "main",
            "preLaunchCommands": [
                "set arm fallback-mode arm"
            ],
            "overrideLaunchCommands": [
                "monitor halt",
                "monitor reset",
                "load",
                "monitor reset"
            ]
        },
        {
            "name": "Debug QSPIFlashDebug (J-Link)",
            "request": "launch",
            "type": "cortex-debug",
